enum ReportReason {
  spam
  harassment
  hate
  sexual
  violence
  illegal
  privacy
  impersonation
  misinformation
  other
}

model ContentReport {
  id         Int          @id @default(autoincrement())
  reporterId Int
  targetType String // "COMMENT" | "RESPONSE"
  targetId   Int
  reason     ReportReason
  details    String?      @db.VarChar(500)
  createdAt  DateTime     @default(now())

  @@unique([reporterId, targetType, targetId])
  @@index([targetType, targetId])
  @@index([reporterId])
  @@index([reason])
}
